{
  "name": "opencode-ask-github",
  "version": "1.0.2-opencode-v2",
  "description": "GitHub repository management plugin for OpenCode - auto-clone repos and analyze with AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosXa/opencode-ask-github.git"
  },
  "bugs": {
    "url": "https://github.com/JosXa/opencode-ask-github/issues"
  },
  "homepage": "https://github.com/JosXa/opencode-ask-github#readme",
  "author": "JosXa",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "github",
    "ai",
    "code-analysis",
    "repository"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build && bun run release:check",
    "release:check": "node scripts/check-release.mjs",
    "format:check": "biome check .",
    "format:fix": "biome check --write ."
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@opencode-ai/theme": "0.0.0-beta-19157",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "^1.2.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19157"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  }
}
