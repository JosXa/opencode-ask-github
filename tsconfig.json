{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "types": ["bun-types", "node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "tui.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
